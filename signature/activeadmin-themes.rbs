# signature/activeadmin-themes.rbs

module ActiveAdmin
  module Themes
    VERSION: String

    def self.registry: () -> Registry

    class StylesheetManifest
      attr_reader parts: Array[String]

      def initialize: (root: String, parts: Array[String]) -> void
      def source: () -> String
    end

    class Skin < Data
      attr_reader key: Symbol
      attr_reader name: String
      attr_reader description: String
      attr_reader manifest: StylesheetManifest

      def source: () -> String
    end

    class Composition < Data
      attr_reader key: Symbol
      attr_reader name: String
      attr_reader description: String
      attr_reader manifest: StylesheetManifest
      attr_reader slots: Hash[Symbol, String]

      def source: () -> String
      def class_for: (String | Symbol slot) -> String
    end

    module Recipes
      module V3
        SKIN_PARTS: Array[String]
        COMPOSITION_PARTS: Array[String]
        PARTS: Array[String]
        SKIN_MANIFEST: StylesheetManifest
        COMPOSITION_MANIFEST: StylesheetManifest

        def self.source: () -> String
      end

      module TexasBluebonnet
        SKIN_PARTS: Array[String]
        COMPOSITION_PARTS: Array[String]
        PARTS: Array[String]
        SKIN_MANIFEST: StylesheetManifest
        COMPOSITION_MANIFEST: StylesheetManifest

        def self.source: () -> String
      end

      module Workbench13
        SKIN_PARTS: Array[String]
        COMPOSITION_PARTS: Array[String]
        PARTS: Array[String]
        SKIN_MANIFEST: StylesheetManifest
        COMPOSITION_MANIFEST: StylesheetManifest

        def self.source: () -> String
      end

      module Workbench2
        SKIN_PARTS: Array[String]
        COMPOSITION_PARTS: Array[String]
        PARTS: Array[String]
        SKIN_MANIFEST: StylesheetManifest
        COMPOSITION_MANIFEST: StylesheetManifest

        def self.source: () -> String
      end
    end

    module Workbench13
      SLOTS: Hash[Symbol, String]
      SKIN: Skin
      COMPOSITION: Composition

      def self.theme: () -> Theme
    end

    module Workbench2
      SLOTS: Hash[Symbol, String]
      SKIN: Skin
      COMPOSITION: Composition

      def self.theme: () -> Theme
    end

    class Recipe
      class Conflict < StandardError
      end
      attr_reader destination: String
      attr_reader entrypoint: String
      attr_reader theme: Theme
      def initialize: (root: String, entrypoint: String, active_admin_version: String, ?key: String | Symbol) -> void
      def status: () -> (:missing | :identical | :modified)
      def install: () -> (:created | :identical)
      def instructions: () -> String
    end

    class InstallationPlan
      class UnsafePath < ArgumentError
      end

      def initialize: (root: String, theme: Theme, active_admin_version: String, files: Hash[String, String]) -> void
      def status: () -> Hash[String, (:missing | :identical | :modified)]
      def installable?: () -> bool
    end

    class Theme < Data
      attr_reader key: Symbol
      attr_reader name: String
      attr_reader description: String
      attr_reader active_admin_requirement: Gem::Requirement
      attr_reader recipe_version: String
      attr_reader skin: Skin
      attr_reader composition: Composition

      def supports?: (String | Gem::Version version) -> bool
      def source: () -> String
    end

    class Registry
      include Enumerable[Theme]

      def initialize: () -> void
      def each: () { (Theme) -> void } -> untyped
      def fetch: (String | Symbol key) -> Theme
      def register: (Theme theme) -> self
      def keys: () -> Array[Symbol]
    end
  end
end
